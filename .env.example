# Example only; never commit real credentials
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://plutus:change-me@localhost:5432/plutus
SESSION_SECRET=replace-with-long-random-secret
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
OPENAI_API_KEY=
CLOUDFLARE_TUNNEL_TOKEN=
OPENAI_MODEL=gpt-4.1-mini
COOKIE_SECURE=true
TRUST_PROXY=false
PUBLIC_ORIGIN=https://inventory.example.com
PLUTUS_BACKUP_DB=plutus
PLUTUS_BACKUP_DIR=/var/backups/plutus
# Notification delivery remains dormant unless provider keys are configured.
RESEND_API_KEY=
EMAIL_FROM=
# Run npm run notifications:queue, then npm run notifications:deliver using a controlled scheduler.
# Never configure test-only API tokens on production.
