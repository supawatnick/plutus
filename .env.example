# Example only; never commit real credentials
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://plutus:change-me@localhost:5432/plutus
SESSION_SECRET=replace-with-long-random-secret
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
OPENAI_API_KEY=
CLOUDFLARE_TUNNEL_TOKEN=
OPENAI_MODEL=gpt-4.1-mini
COOKIE_SECURE=true
TRUST_PROXY=false
PUBLIC_ORIGIN=https://inventory.example.com
PLUTUS_BACKUP_DB=plutus
PLUTUS_BACKUP_DIR=/var/backups/plutus
# EMAIL provider is intentionally not configured; queued notifications are not delivered.
