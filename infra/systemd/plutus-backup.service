[Unit]
Description=Plutus PostgreSQL daily backup
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
Environment=BACKUP_DIR=/var/backups/plutus
Environment=DATABASE_URL=postgresql://root@localhost/plutus?host=/var/run/postgresql
ExecStart=/usr/bin/bash /srv/mcp-workspaces/plutus/scripts/backup-postgres.sh
NoNewPrivileges=true
PrivateTmp=true
