[Unit]
Description=Plutus PostgreSQL daily backup
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
Environment=PLUTUS_BACKUP_DB=plutus
Environment=PLUTUS_BACKUP_DIR=/var/backups/plutus
ExecStart=/srv/mcp-workspaces/plutus/scripts/backup-postgres.sh
NoNewPrivileges=true
PrivateTmp=true
