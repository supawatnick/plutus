{
  "name": "plutus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:api": "node tests/api-integration.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "notifications:queue": "node scripts/queue-reminders.mjs",
    "notifications:deliver": "node scripts/deliver-notifications.mjs",
    "ops:preflight": "node scripts/production-preflight.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
