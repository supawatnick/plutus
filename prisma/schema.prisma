// Plutus initial relational model — review before first migration.
// Prisma 6+ compatible schema. Prisma datasource URL supplied by environment.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum AssetStatus {
  AVAILABLE
  BORROWED
  DEMO_LAB
  RETIRED
}
enum InventoryKind {
  SERIALIZED
  QUANTITY
}
enum UserRole {
  ADMIN
  ASSET_MANAGER
  VIEWER
}
enum LoanStatus {
  OPEN
  PARTIAL
  CLOSED
}
enum NotificationChannel {
  EMAIL
  LINE
}
enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  loansOut     Loan[]   @relation("CheckedOutBy")
  returnsIn    Return[] @relation("ReceivedBy")
  auditEvents  AuditEvent[]
  sessions     Session[]
  lineAccounts LineAccount[]
}
model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  revokedAt  DateTime?
  user       User     @relation(fields: [userId], references: [id])
  @@index([userId, expiresAt])
}
model InventoryItem {
  id            String        @id @default(uuid())
  displayId     String        @unique // AST-000001 or STOCK-000001, assigned transactionally
  name          String
  serialNumber  String?       @unique
  kind          InventoryKind
  status        AssetStatus   @default(AVAILABLE)
  location      String
  totalQuantity Int          @default(1)
  availableQty  Int          @default(1)
  deletedAt     DateTime?
  deletedById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  loans         Loan[]
  @@index([status, deletedAt])
  @@index([name])
}
model Loan {
  id                 String     @id @default(uuid())
  loanNumber         String     @unique
  inventoryItemId    String
  borrowerName       String
  borrowerEmail      String
  customerName       String
  customerSite       String
  projectName        String
  purpose            String?
  checkedOutAt       DateTime   @default(now())
  expectedReturnAt   DateTime?
  closedAt           DateTime?
  checkedOutById     String
  quantityBorrowed   Int
  quantityReturned   Int        @default(0)
  status             LoanStatus @default(OPEN)
  inventoryItem      InventoryItem @relation(fields: [inventoryItemId], references: [id])
  checkedOutBy       User       @relation("CheckedOutBy", fields: [checkedOutById], references: [id])
  returns            Return[]
  notifications      Notification[]
  @@index([status, expectedReturnAt])
  @@index([inventoryItemId, status])
}
model Return {
  id                String   @id @default(uuid())
  loanId            String
  quantity          Int
  newLocation       String
  resultingStatus   AssetStatus?
  receivedById      String
  returnedAt        DateTime @default(now())
  loan              Loan     @relation(fields: [loanId], references: [id])
  receivedBy        User     @relation("ReceivedBy", fields: [receivedById], references: [id])
}
model AuditEvent {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  occurredAt  DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
  @@index([entityType, entityId, occurredAt])
  @@index([occurredAt])
}
model Notification {
  id            String             @id @default(uuid())
  loanId        String?
  channel       NotificationChannel
  eventKey      String             @unique
  recipient     String
  status        NotificationStatus @default(PENDING)
  scheduledAt   DateTime
  sentAt        DateTime?
  attempts      Int                @default(0)
  lastError     String?
  loan          Loan?              @relation(fields: [loanId], references: [id])
  @@index([status, scheduledAt])
}
model LineAccount {
  id          String   @id @default(uuid())
  userId      String
  lineUserId  String   @unique
  verifiedAt  DateTime
  revokedAt   DateTime?
  user        User     @relation(fields: [userId], references: [id])
}
model Sequence {
  name      String @id
  nextValue Int
}
model BackupRun {
  id          String   @id @default(uuid())
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  status      String
  filePath    String?
  error       String?
}
